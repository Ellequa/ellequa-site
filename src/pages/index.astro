---
import { Image } from 'astro:assets';
import hero from '../../public/images/01_under0038.jpg';
import steps from '../../public/images/12_4seassteps.jpg';
import windowPortrait from '../../public/images/08_window_gaze_bnw.jpg';
import afternoon from '../../public/images/15_daygame0020.jpg';
import portrait from '../../public/images/02_akash_ lux0001.jpg';
import archive from '../../public/images/07_dreamybedglow.jpg';
const description = 'A visual diary by Ellequa. Studies in light, stillness and the moments in between.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f0e9" />
    <meta property="og:title" content="Ellequa — A visual diary" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Ellequa — A visual diary</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="brand" href="#top" aria-label="Ellequa — home">Ellequa</a>
      <nav aria-label="Main navigation">
        <a href="#collection">Collection</a>
        <a href="/archive/">Archive</a>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <figure class="hero-photo">
          <Image src={hero} alt="Ellequa in a turquoise pool beneath a shaft of sunlight." widths={[480, 800, 1200]} sizes="(max-width: 700px) 94vw, 640px" width={800} format="webp" quality={85} loading="eager" fetchpriority="high" />
          <figcaption><h1 id="hero-title">Ellequa — a photographic journal</h1><span>01 / Into the light</span></figcaption>
        </figure>
      </section>

      <section id="collection" class="collection wrap" aria-labelledby="collection-title">
        <div class="section-heading">
          <h2 id="collection-title">Selected photographs</h2>
          <span>01 — 06</span>
        </div>
        <div class="portrait-pair">
          <figure class="sunlight">
            <Image src={steps} alt="Ellequa on pale stone steps in warm afternoon sunlight." widths={[400, 700, 1040]} sizes="(max-width: 700px) 88vw, 45vw" width={700} format="webp" quality={85} loading="lazy" />
            <figcaption><span>02 / Sun-warmed</span><span>Light &amp; place</span></figcaption>
          </figure>
          <figure class="monochrome">
            <Image src={windowPortrait} alt="Black-and-white portrait of Ellequa beside a tall window." widths={[400, 700, 1000]} sizes="(max-width: 700px) 70vw, 30vw" width={700} format="webp" quality={85} loading="lazy" />
            <figcaption><span>03 / A quieter light</span><span>Monochrome</span></figcaption>
          </figure>
        </div>
        <div class="landscape-story">
          <figure>
            <Image src={afternoon} alt="Ellequa reclining beneath soft white drapery in the afternoon light." widths={[480, 800, 1200, 1600]} sizes="(max-width: 700px) 88vw, 65vw" width={1200} format="webp" quality={85} loading="lazy" />
            <figcaption><span>04 / Slow hours</span><span>In repose</span></figcaption>
          </figure>
        </div>
        <div class="closing-study">
          <figure>
            <Image src={portrait} alt="An intimate portrait of Ellequa with patterned light falling across the room." widths={[400, 700, 1000]} sizes="(max-width: 700px) 70vw, 30vw" width={700} format="webp" quality={85} loading="lazy" />
            <figcaption><span>05 / Held close</span><span>A portrait</span></figcaption>
          </figure>
          <figure>
            <Image src={archive} alt="Ellequa resting beside sheer curtains in a softly sunlit room." widths={[400, 700, 1000]} sizes="(max-width: 700px) 68vw, 29vw" width={700} format="webp" quality={85} loading="lazy" />
            <figcaption>06 / Behind the curtain</figcaption>
          </figure>
        </div>
      </section>
      <section id="archive" class="archive wrap" aria-labelledby="archive-title">
        <div>
          <h2 id="archive-title">Archive</h2>
          <p>Photographs &amp; collected editorials.</p>
        </div>
        <a class="text-link" href="/archive/">View the archive <span aria-hidden="true">→</span></a>
      </section>
    </main>
    <footer class="wrap"><a class="brand" href="#top">Ellequa</a><span>© {new Date().getFullYear()} Ellequa</span><a class="back-top" href="#top">Back to top <span aria-hidden="true">↑</span></a></footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 28px; }
  :global(body) { margin: 0; background: #f3f0e9; color: #302f29; font-family: Arial, Helvetica, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(::selection) { background: #d9ccaf; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible) { outline: 2px solid #887153; outline-offset: 6px; }
  :global(img) { display: block; width: 100%; height: auto; background: #e5dfd3; }
  :global(figure), :global(p), :global(h1), :global(h2) { margin: 0; }
  .wrap { width: min(calc(100% - 112px), 1160px); margin-inline: auto; }
  .site-header { display: flex; align-items: center; justify-content: space-between; min-height: 90px; }
  .brand { font-family: Georgia, 'Times New Roman', serif; font-size: 26px; letter-spacing: -1px; }
  nav { display: flex; gap: 34px; }
  nav a, .back-top { font-size: 11px; letter-spacing: .05em; padding-block: 15px; }
  nav a:hover, .back-top:hover { text-decoration: underline; text-underline-offset: 5px; }
  .hero { padding-top: 10px; }
  .hero-photo { width: min(100%, 640px); margin: 0 auto; }
  figcaption { display: flex; justify-content: space-between; gap: 16px; margin-top: 12px; font-size: 10px; line-height: 1.6; color: #6b685f; }
  h1 { font: inherit; color: #302f29; }
  h2 { font-size: 11px; font-weight: 400; letter-spacing: .06em; }
  .collection { padding-block: 90px 80px; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; padding-top: 18px; border-top: 1px solid #d7d2c7; margin-bottom: 32px; }
  .section-heading > span { font-size: 10px; color: #6b685f; }
  .portrait-pair { display: grid; grid-template-columns: 1.2fr 1fr; gap: 10%; align-items: start; }
  .monochrome { margin-top: 120px; }
  .landscape-story { width: 85%; margin: 95px auto; }
  .closing-study { display: grid; grid-template-columns: 1fr 1.2fr; gap: 13%; align-items: start; width: 88%; margin-inline: auto; }
  .closing-study > figure:last-child { margin-top: 95px; }
  .archive { display: flex; align-items: center; justify-content: space-between; gap: 24px; border-block: 1px solid #d7d2c7; padding-block: 28px; }
  .archive h2 { font-family: Georgia, serif; font-size: 22px; letter-spacing: -.02em; }
  .archive p { color: #6b685f; font-size: 11px; margin-top: 9px; line-height: 1.6; }
  .text-link { display: inline-flex; align-items: center; gap: 25px; min-height: 44px; font-size: 11px; border-bottom: 1px solid #aaa497; }
  .text-link:hover { color: #887153; }
  .text-link > span[aria-hidden] { font-size: 16px; }
  footer { min-height: 110px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  footer .brand { font-size: 23px; }
  footer > span { font-size: 10px; color: #6b685f; }
  .sr-only, .skip-link:not(:focus) { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  .skip-link:focus { position: fixed; left: 20px; top: 20px; z-index: 20; padding: 15px; background: #f3f0e9; }
  @media (max-width: 1000px) {
    .wrap { width: calc(100% - 64px); }
    .hero-photo { width: min(100%, 600px); }
    .portrait-pair { gap: 7%; }
    .monochrome { margin-top: 80px; }
  }
  @media (max-width: 700px) {
    .wrap { width: calc(100% - 36px); }
    .site-header { min-height: 76px; }
    .brand { font-size: 25px; }
    nav { gap: 24px; }
    nav a { font-size: 10px; }
    .hero { width: calc(100% - 24px); padding-top: 0; }
    .hero-photo { width: 100%; }
    .hero-photo figcaption { padding-inline: 6px; font-size: 9px; gap: 10px; }
    .collection { padding-block: 54px; }
    .section-heading { margin-bottom: 26px; }
    .portrait-pair { grid-template-columns: 1fr; gap: 40px; }
    .sunlight { width: 94%; }
    .monochrome { width: 80%; margin-top: 0; justify-self: end; }
    .landscape-story { width: 100%; margin-block: 48px; }
    .closing-study { width: 100%; grid-template-columns: 1fr; gap: 40px; }
    .closing-study > figure:first-child { width: 78%; }
    .closing-study > figure:last-child { width: 90%; justify-self: end; margin-top: 0; }
    .archive { align-items: start; flex-direction: column; gap: 14px; padding-block: 24px; }
    footer { min-height: 100px; gap: 10px; }
    footer .brand { font-size: 21px; }
    footer > span, .back-top { font-size: 9px; }
  }
  @media (prefers-reduced-motion: reduce) { :global(html) { scroll-behavior: auto; } }
</style>

