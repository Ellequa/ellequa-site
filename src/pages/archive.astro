---
import { Image } from 'astro:assets';
import morning from '../../public/images/06_under0043.jpg';
import denim from '../../public/images/10_denim_floor.jpg';
import shore from '../../public/images/05_kneel_coco.jpg';
import water from '../../public/images/14_office0029.jpg';
import portrait from '../../public/images/02_akash_ lux0001.jpg';
import curtain from '../../public/images/07_dreamybedglow.jpg';
import gold from '../../public/images/03_ricedrem1.jpg';
import busStop from '../../public/images/on-the-way-home-01-bus-stop.jpg';
import bench from '../../public/images/on-the-way-home-02-bench.jpg';
import heels from '../../public/images/on-the-way-home-03-heels.jpg';
import cafeStreet from '../../public/images/on-the-way-home-04-cafe-street.jpg';
import scooter from '../../public/images/on-the-way-home-05-scooter.jpg';
const homeStory = [
  { image: busStop, title: 'Waiting', note: 'After-hours', placement: 'story-opening', sizes: '(max-width: 700px) 92vw, (min-width: 1272px) 638px, 55vw', alt: 'On the Way Home: waiting at a bus stop.' },
  { image: bench, title: 'After the music', note: 'A quiet pause', placement: 'story-pause', sizes: '(max-width: 700px) 80vw, (min-width: 1272px) 499px, 43vw', alt: 'On the Way Home: a quiet pause on a bench.' },
  { image: heels, title: 'Almost home', note: 'Between leaving and arriving', placement: 'story-centre', sizes: '(max-width: 700px) 92vw, (min-width: 1272px) 673px, 58vw', alt: 'On the Way Home: pausing to adjust a shoe.' },
  { image: cafeStreet, title: 'Morning streets', note: 'The city waking', placement: 'story-street', sizes: '(max-width: 700px) 82vw, (min-width: 1272px) 487px, 42vw', alt: 'On the Way Home: a morning street beside a café.' },
  { image: scooter, title: 'Daybreak', note: 'Home soon', placement: 'story-closing', sizes: '(max-width: 700px) 76vw, (min-width: 1272px) 418px, 36vw', alt: 'On the Way Home: a scooter at daybreak.' },
];
const outsideStory = [
  { src: '/images/shower-bliss-01-outside.jpg', placement: 'story-opening', alt: 'Outside — establishing frame.' },
  { src: '/images/shower-bliss-02-back-view.jpg', placement: 'story-pause', alt: 'Outside — full back view.' },
  { src: '/images/shower-bliss-03-sunlit-closeup.jpg', placement: 'story-centre', alt: 'Outside — sunlit close-up.' },
  { src: '/images/shower-bliss-04-over-shoulder.jpg', placement: 'story-closing', alt: 'Outside — over-the-shoulder frame.' },
];
const studies = [
  { image: morning, title: 'Morning light', note: 'Interior study', placement: 'opening', sizes: '(max-width: 700px) 88vw, 50vw', alt: 'Ellequa seated beside a sunlit window overlooking green foliage.' },
  { image: denim, title: 'In monochrome', note: 'Portrait study', placement: 'monochrome', sizes: '(max-width: 700px) 75vw, 40vw', alt: 'Black-and-white photograph of Ellequa reclining on a wooden floor in denim.' },
  { image: water, title: 'Water study', note: 'Light & movement', placement: 'feature', sizes: '(max-width: 700px) 92vw, 75vw', alt: 'Ellequa beneath falling water, with sunlight and a red flower in her hair.' },
  { image: shore, title: 'By the water', note: 'On location', placement: 'shore', sizes: '(max-width: 700px) 78vw, 40vw', alt: 'Ellequa beneath a thatched beach shelter beside the water.' },
  { image: portrait, title: 'Held close', note: 'Portrait', placement: 'portrait', sizes: '(max-width: 700px) 73vw, 32vw', alt: 'Ellequa looking toward the camera in a softly lit room.' },
  { image: curtain, title: 'Behind the curtain', note: 'Interior light', placement: 'curtain', sizes: '(max-width: 700px) 86vw, 48vw', alt: 'Ellequa reclining beside sheer curtains in a sunlit room.' },
  { image: gold, title: 'Late light', note: 'Study in gold', placement: 'closing', sizes: '(max-width: 700px) 70vw, 32vw', alt: 'Ellequa standing in a field in a golden dress, backlit by the late sun.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Archive — Ellequa</title>
    <meta name="description" content="Selected photographs, video work and further studies from the Ellequa archive." />
    <meta name="theme-color" content="#f3f0e9" />
    <link rel="canonical" href="https://ellequa.com/archive" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ellequa" />
    <meta property="og:title" content="Archive — Ellequa" />
    <meta property="og:description" content="Selected photographs, video work and further studies from the Ellequa archive." />
    <meta property="og:url" content="https://ellequa.com/archive" />
    <meta property="og:image" content="https://ellequa.com/images/ellequa-social-1200x630-v2.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ellequa archive" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Archive — Ellequa" />
    <meta name="twitter:description" content="Selected photographs, video work and further studies from the Ellequa archive." />
    <meta name="twitter:image" content="https://ellequa.com/images/ellequa-social-1200x630-v2.jpg" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="wrap site-header">
      <a class="brand" href="/" aria-label="Ellequa — home">Ellequa</a>
      <nav aria-label="Main navigation">
        <a href="/#collection">Collection</a>
        <a href="/archive/" aria-current="page">Archive</a>
      </nav>
    </header>
    <main id="main" class="wrap">
      <div class="archive-heading">
        <h1>Archive</h1>
        <p>Photographs &amp; collected editorials.</p>
      </div>
      <section class="studies" aria-label="Photographic studies">
        {studies.map((study, index) => (
          <figure class={study.placement}>
            <Image src={study.image} alt={study.alt} widths={[400, 700, 1000, 1400].filter((width) => width <= study.image.width)} sizes={study.sizes} width={700} format="webp" quality={85} loading={index === 0 ? 'eager' : 'lazy'} />
            <figcaption><span>0{index + 1} / {study.title}</span><span>{study.note}</span></figcaption>
          </figure>
        ))}
      </section>
      <section class="home-story" aria-labelledby="home-story-title">
        <div class="story-intro">
          <p class="story-label">01 — STUDY</p>
          <h2 id="home-story-title">On the Way Home</h2>
          <p>A study in after-hours light, empty streets and the space between leaving and arriving.</p>
        </div>
        <div class="story-sequence">
          {homeStory.map((study, index) => (
            <figure class={study.placement}>
              <Image src={study.image} alt={study.alt} widths={[400, 700, 1000, 1300].filter((width) => width <= study.image.width)} sizes={study.sizes} width={700} format="webp" quality={85} loading="lazy" />
              <figcaption><span>0{index + 1} / {study.title}</span><span>{study.note}</span></figcaption>
            </figure>
          ))}
        </div>
      </section>
      <section class="home-story" aria-labelledby="outside-story-title">
        <div class="story-intro">
          <h2 id="outside-story-title">Outside</h2>
          <p>Bali does have its perks.</p>
        </div>
        <div class="story-sequence">
          {outsideStory.map((frame, index) => (
            <figure class={frame.placement}>
              <img src={frame.src} alt={frame.alt} loading="lazy" decoding="async" />
              <figcaption>{String(index + 1).padStart(2, '0')}</figcaption>
            </figure>
          ))}
        </div>
      </section>
      <section class="private-index" aria-labelledby="private-title">
        <div>
          <h2 id="private-title">Private archive</h2>
          <p>Further visual studies, moving images and collected works.</p>
        </div>
        <a class="text-link" href="https://onlyfans.com/ellequa" target="_blank" rel="noopener noreferrer">View the extended archive <span aria-hidden="true">→</span><span class="sr-only"> (external site, opens in a new tab)</span></a>
      </section>
    </main>
    <footer class="wrap">
      <a class="brand" href="/">Ellequa</a>
      <span>© {new Date().getFullYear()} Ellequa</span>
      <a class="return-link" href="/#collection">Back to collection <span aria-hidden="true">↗</span></a>
    </footer>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-padding-top: 28px; }
  :global(body) { margin: 0; background: #f3f0e9; color: #302f29; font-family: Arial, Helvetica, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(::selection) { background: #d9ccaf; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible) { outline: 2px solid #887153; outline-offset: 6px; }
  :global(img) { display: block; width: 100%; height: auto; background: #e5dfd3; }
  figure, p, h1, h2 { margin: 0; }
  .wrap { width: min(calc(100% - 112px), 1160px); margin-inline: auto; }
  .site-header { display: flex; align-items: center; justify-content: space-between; min-height: 90px; }
  .brand { font-family: Georgia, 'Times New Roman', serif; font-size: 26px; letter-spacing: -1px; }
  nav { display: flex; gap: 34px; }
  nav a, .return-link { font-size: 11px; letter-spacing: .05em; padding-block: 15px; }
  nav a:hover, nav a[aria-current], .return-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  .archive-heading { border-top: 1px solid #d7d2c7; padding-top: 24px; margin-bottom: 42px; display: flex; align-items: baseline; justify-content: space-between; gap: 20px; }
  h1, h2 { font: 400 22px Georgia, serif; letter-spacing: -.02em; }
  p { font-size: 11px; line-height: 1.6; color: #6b685f; }
  /* Each plate has an explicit position; document order remains the reading order. */
  .studies { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 24px; row-gap: 110px; align-items: start; padding-bottom: 130px; }
  .opening { grid-column: 1 / 7; grid-row: 1; }
  .monochrome { grid-column: 8 / 13; grid-row: 1; margin-top: 170px; }
  .feature { grid-column: 2 / 11; grid-row: 2; margin-block: 35px; }
  .shore { grid-column: 8 / 13; grid-row: 3; }
  .portrait { grid-column: 2 / 6; grid-row: 4; }
  .curtain { grid-column: 7 / 13; grid-row: 4; margin-top: 120px; }
  .closing { grid-column: 4 / 8; grid-row: 5; margin-top: 25px; }
  figcaption { display: flex; justify-content: space-between; gap: 12px; margin-top: 12px; font-size: 10px; line-height: 1.6; color: #6b685f; }
  .private-index { display: flex; align-items: center; justify-content: space-between; gap: 24px; border-block: 1px solid #d7d2c7; padding-block: 28px; }
  .private-index p { margin-top: 9px; }
  .text-link { display: inline-flex; align-items: center; gap: 25px; min-height: 44px; font-size: 11px; border-bottom: 1px solid #aaa497; }
  .text-link:hover { color: #887153; }
  .text-link > span[aria-hidden] { font-size: 16px; }
  footer { min-height: 110px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  footer .brand { font-size: 23px; }
  footer > span { font-size: 10px; color: #6b685f; }
  .sr-only, .skip-link:not(:focus) { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  .skip-link:focus { position: fixed; left: 20px; top: 20px; z-index: 20; padding: 15px; background: #f3f0e9; }
  @media (max-width: 1000px) {
    .wrap { width: calc(100% - 64px); }
    .studies { column-gap: 16px; row-gap: 80px; }
    .monochrome { margin-top: 110px; }
    .curtain { margin-top: 85px; }
  }
  @media (max-width: 700px) {
    .wrap { width: calc(100% - 36px); }
    .site-header { min-height: 76px; }
    .brand { font-size: 25px; }
    nav { gap: 24px; }
    nav a { font-size: 10px; }
    .archive-heading { align-items: start; flex-direction: column; gap: 9px; margin-bottom: 30px; }
    .studies { grid-template-columns: 1fr; gap: 48px; padding-bottom: 80px; }
    .studies figure { grid-column: 1; grid-row: auto; margin: 0; }
    .studies .opening { width: 96%; }
    .studies .monochrome { width: 82%; justify-self: end; }
    .studies .feature { width: 100%; margin-block: 20px; }
    .studies .shore { width: 85%; justify-self: end; }
    .studies .portrait { width: 80%; }
    .studies .curtain { width: 94%; justify-self: end; }
    .studies .closing { width: 76%; justify-self: center; margin-top: 12px; }
    .private-index { align-items: start; flex-direction: column; gap: 14px; padding-block: 24px; }
    footer { min-height: 100px; gap: 10px; }
    footer .brand { font-size: 21px; }
    footer > span, .return-link { font-size: 9px; }
  }
  .home-story { padding-bottom: 130px; }
  .story-intro { border-top: 1px solid #d7d2c7; padding-top: 28px; margin-bottom: 65px; }
  .story-intro .story-label { font-size: 10px; letter-spacing: .12em; margin-bottom: 16px; }
  .story-intro h2 { margin-bottom: 14px; }
  .story-intro > p:last-child { max-width: 410px; }
  .story-sequence { display: flex; flex-direction: column; align-items: flex-start; gap: 100px; }
  .story-opening { width: 55%; }
  .story-pause { width: 43%; align-self: flex-end; }
  .story-centre { width: 58%; margin-left: 8%; margin-block: 35px; }
  .story-street { width: 42%; margin-right: 5%; align-self: flex-end; }
  .story-closing { width: 36%; margin-left: 22%; margin-top: 20px; }
  .home-story figcaption > span:last-child { text-align: right; }
  @media (max-width: 1000px) {
    .story-sequence { gap: 80px; }
  }
  @media (max-width: 700px) {
    .home-story { padding-bottom: 80px; }
    .story-intro { margin-bottom: 40px; }
    .story-sequence { gap: 52px; }
    .story-sequence figure { margin-inline: 0; }
    .story-sequence .story-opening { width: 100%; }
    .story-sequence .story-pause { width: 87%; }
    .story-sequence .story-centre { width: 100%; margin-block: 16px; }
    .story-sequence .story-street { width: 89%; }
    .story-sequence .story-closing { width: 82%; align-self: center; margin-top: 12px; }
  }
</style>
