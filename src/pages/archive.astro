---
import { Image } from 'astro:assets';
import morning from '../../public/images/06_under0043.jpg';
import denim from '../../public/images/10_denim_floor.jpg';
import shore from '../../public/images/05_kneel_coco.jpg';
const studies = [
  { image: morning, title: 'Morning light', note: 'Interior study', alt: 'Ellequa seated beside a sunlit window overlooking green foliage.' },
  { image: denim, title: 'In monochrome', note: 'Portrait study', alt: 'Black-and-white photograph of Ellequa reclining on a wooden floor in denim.' },
  { image: shore, title: 'By the water', note: 'On location', alt: 'Ellequa beneath a thatched beach shelter beside the water.' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="The Ellequa archive. Photographs, interior studies and collected editorials." />
    <meta name="theme-color" content="#f3f0e9" />
    <meta property="og:title" content="Archive — Ellequa" />
    <meta property="og:description" content="Photographs, interior studies and collected editorials." />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Archive — Ellequa</title>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="wrap site-header">
      <a class="brand" href="/" aria-label="Ellequa — home">Ellequa</a>
      <nav aria-label="Main navigation">
        <a href="/#collection">Collection</a>
        <a href="/archive/" aria-current="page">Archive</a>
      </nav>
    </header>
    <main id="main" class="wrap">
      <div class="archive-heading">
        <h1>Archive</h1>
        <p>Photographs &amp; collected editorials.</p>
      </div>
      <section class="studies" aria-label="Photographic studies">
        {studies.map((study, index) => (
          <figure>
            <Image src={study.image} alt={study.alt} widths={[400, 700, 900]} sizes="(max-width: 700px) 85vw, (max-width: 1000px) 42vw, 350px" width={700} format="webp" quality={85} loading={index === 0 ? 'eager' : 'lazy'} />
            <figcaption><span>0{index + 1} / {study.title}</span><span>{study.note}</span></figcaption>
          </figure>
        ))}
      </section>
      <section class="private-index" aria-labelledby="private-title">
        <div>
          <h2 id="private-title">Private archive</h2>
          <p>Further visual studies, moving images and collected works.</p>
        </div>
        <a class="text-link" href="https://onlyfans.com/ellequa" target="_blank" rel="noopener noreferrer">View the extended archive <span aria-hidden="true">→</span><span class="sr-only"> (external site, opens in a new tab)</span></a>
      </section>
    </main>
    <footer class="wrap">
      <a class="brand" href="/">Ellequa</a>
      <span>© {new Date().getFullYear()} Ellequa</span>
      <a class="return-link" href="/#collection">Back to collection <span aria-hidden="true">↗</span></a>
    </footer>
  </body>
</html>
<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-padding-top: 28px; }
  :global(body) { margin: 0; background: #f3f0e9; color: #302f29; font-family: Arial, Helvetica, sans-serif; -webkit-font-smoothing: antialiased; }
  :global(::selection) { background: #d9ccaf; }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible) { outline: 2px solid #887153; outline-offset: 6px; }
  :global(img) { display: block; width: 100%; height: auto; background: #e5dfd3; }
  figure, p, h1, h2 { margin: 0; }
  .wrap { width: min(calc(100% - 112px), 1160px); margin-inline: auto; }
  .site-header { display: flex; align-items: center; justify-content: space-between; min-height: 90px; }
  .brand { font-family: Georgia, 'Times New Roman', serif; font-size: 26px; letter-spacing: -1px; }
  nav { display: flex; gap: 34px; }
  nav a, .return-link { font-size: 11px; letter-spacing: .05em; padding-block: 15px; }
  nav a:hover, nav a[aria-current], .return-link:hover { text-decoration: underline; text-underline-offset: 5px; }
  .archive-heading { border-top: 1px solid #d7d2c7; padding-top: 24px; margin-bottom: 42px; display: flex; align-items: baseline; justify-content: space-between; gap: 20px; }
  h1, h2 { font: 400 22px Georgia, serif; letter-spacing: -.02em; }
  p { font-size: 11px; line-height: 1.6; color: #6b685f; }
  .studies { display: grid; grid-template-columns: 1fr .87fr 1fr; gap: 5%; align-items: start; padding-bottom: 80px; }
  .studies figure:nth-child(2) { margin-top: 95px; }
  .studies figure:nth-child(3) { margin-top: 35px; }
  figcaption { display: flex; justify-content: space-between; gap: 12px; margin-top: 12px; font-size: 10px; line-height: 1.6; color: #6b685f; }
  .private-index { display: flex; align-items: center; justify-content: space-between; gap: 24px; border-block: 1px solid #d7d2c7; padding-block: 28px; }
  .private-index p { margin-top: 9px; }
  .text-link { display: inline-flex; align-items: center; gap: 25px; min-height: 44px; font-size: 11px; border-bottom: 1px solid #aaa497; }
  .text-link:hover { color: #887153; }
  .text-link > span[aria-hidden] { font-size: 16px; }
  footer { min-height: 110px; display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  footer .brand { font-size: 23px; }
  footer > span { font-size: 10px; color: #6b685f; }
  .sr-only, .skip-link:not(:focus) { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; }
  .skip-link:focus { position: fixed; left: 20px; top: 20px; z-index: 20; padding: 15px; background: #f3f0e9; }
  @media (max-width: 1000px) {
    .wrap { width: calc(100% - 64px); }
    .studies { grid-template-columns: 1fr 1fr; gap: 40px; }
    .studies figure:nth-child(3) { width: 85%; margin-top: 0; }
  }
  @media (max-width: 700px) {
    .wrap { width: calc(100% - 36px); }
    .site-header { min-height: 76px; }
    .brand { font-size: 25px; }
    nav { gap: 24px; }
    nav a { font-size: 10px; }
    .archive-heading { align-items: start; flex-direction: column; gap: 9px; margin-bottom: 30px; }
    .studies { grid-template-columns: 1fr; gap: 40px; padding-bottom: 50px; }
    .studies figure:first-child { width: 94%; }
    .studies figure:nth-child(2) { width: 80%; justify-self: end; margin-top: 0; }
    .studies figure:nth-child(3) { width: 92%; }
    .private-index { align-items: start; flex-direction: column; gap: 14px; padding-block: 24px; }
    footer { min-height: 100px; gap: 10px; }
    footer .brand { font-size: 21px; }
    footer > span, .return-link { font-size: 9px; }
  }
</style>
